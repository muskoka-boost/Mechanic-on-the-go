---
import { business } from '../data/business';
import { withBase } from '../lib/paths';
---

<section class="hero">
  <div class="hero__media">
    <img src={withBase('/images/hero.jpg')} alt="" width="2000" height="1250" fetchpriority="high" decoding="async" />
    <div class="hero__scrim"></div>
    <div class="hero__grain" aria-hidden="true"></div>
  </div>

  <div class="wrap hero__inner">
    <p class="hero__eyebrow">
      <span class="dot" aria-hidden="true"></span>
      Orillia &middot; Simcoe County &middot; Muskoka &middot; Georgian Bay
    </p>

    <h1 class="hero__title">
      We bring the<br />
      <span class="hero__accent">garage to your</span><br />
      driveway.
    </h1>

    <p class="hero__lede">
      Diagnostics, brakes, batteries and suspension repaired where your vehicle
      already sits &mdash; at home, at work, or on the side of the road. No tow
      truck. No waiting room. No day off work.
    </p>

    <div class="hero__cta">
      <a href={business.phoneHref} class="btn btn--primary btn--lg">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1z" />
        </svg>
        {business.phone}
      </a>
      <a href={withBase('/services/')} class="btn btn--ghost btn--lg">What We Fix</a>
    </div>

    <ul class="hero__proof">
      <li><strong>Same-day</strong><span>service in Orillia</span></li>
      <li><strong>No tow</strong><span>needed for most no-starts</span></li>
      <li><strong>{business.serviceRadiusKm} km</strong><span>service radius</span></li>
      <li><strong>Upfront</strong><span>pricing before work starts</span></li>
    </ul>
  </div>

  <div class="hero__fade" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(600px, 92svh, 940px);
    padding-block: clamp(90px, 12vh, 150px) clamp(60px, 8vh, 110px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  /* Layered scrim: dark from the left for text contrast, dark from the
     bottom so the section blends into the page below. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(7, 13, 19,0.96) 0%, rgba(7, 13, 19,0.86) 34%, rgba(7, 13, 19,0.42) 66%, rgba(7, 13, 19,0.28) 100%),
      linear-gradient(to top, var(--bg) 2%, rgba(7, 13, 19,0.1) 45%);
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: repeating-linear-gradient(
      118deg,
      rgba(255,255,255,0.022) 0px,
      rgba(255,255,255,0.022) 1px,
      transparent 1px,
      transparent 5px
    );
  }

  .hero__inner { position: relative; z-index: 1; }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--steel-300);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    padding: 9px 20px;
    margin: 0 0 30px;
  }
  .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px rgba(53, 192, 122, 0.22);
    flex-shrink: 0;
  }

  .hero__title {
    max-width: 15ch;
    font-size: clamp(3rem, 8.4vw, 6.4rem);
    line-height: 0.94;
    letter-spacing: -0.02em;
    margin-bottom: 26px;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.55);
  }
  .hero__accent { color: var(--brand); }

  .hero__lede {
    max-width: 54ch;
    font-size: clamp(1.06rem, 1.9vw, 1.3rem);
    color: var(--steel-200);
    margin-bottom: 38px;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 54px; }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 780px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hero__proof li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 22px;
    background: rgba(7, 13, 19, 0.72);
    backdrop-filter: blur(6px);
  }
  .hero__proof strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--brand);
    line-height: 1;
  }
  .hero__proof span { font-size: 0.92rem; color: var(--text-muted); line-height: 1.4; }

  .hero__fade {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 90px;
    background: linear-gradient(to top, var(--bg), transparent);
    z-index: 0;
  }

  @media (min-width: 760px) {
    .hero__proof { grid-template-columns: repeat(4, 1fr); }
  }
</style>
