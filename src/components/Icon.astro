  brake: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 3v5M21 12h-5M12 21v-5M3 12h5',
  bolt: 'M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5z',
  droplet: 'M12 3s6 6.4 6 10.5a6 6 0 0 1-12 0C6 9.4 12 3 12 3z',
  spring: 'M6 3h12M7 7h10M6 11h12M7 15h10M6 19h12M9 3v16M15 5v16',
  thermo: 'M12 14V4a2 2 0 1 1 4 0v10a4 4 0 1 1-4 0zM7 6H3M7 11H3M7 16H3',
  tire: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm0 4.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM12 3v4.5M18.8 8.5l-4.3 1.4M16.2 19.4l-2.7-3.6M7.8 19.4l2.7-3.6M5.2 8.5l4.3 1.4',
  check: 'M9 11l3 3 7-7M21 12a9 9 0 1 1-4.5-7.8',
