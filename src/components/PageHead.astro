---
export interface Props { eyebrow: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="phead">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede phead__lede">{lede}</p>}
  </div>
</section>

<style>
  .phead {
    padding-block: clamp(60px, 9vw, 110px) clamp(38px, 5vw, 60px);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(900px 380px at 8% -10%, rgba(41,163,224,0.11), transparent 70%),
      var(--bg);
  }
  .phead h1 { max-width: 18ch; margin-bottom: 22px; }
  .phead__lede { max-width: 62ch; margin: 0; }
</style>
