---
import { business } from '../data/business';
import { withBase } from '../lib/paths';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? path === full : path.startsWith(full);
};

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/about/', label: 'About' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="hdr">
  <div class="wrap hdr__inner">
    <a href={withBase('/')} class="brand" aria-label={`${business.name} — home`}>
      <span class="brand__mark" aria-hidden="true">
        <!-- Tyre + wrench, echoing the logo mark. Replace with the supplied
             transparent-background logo file when it is available. -->
        <svg viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="15.5" stroke="currentColor" stroke-width="3.4" opacity="0.95" />
          <circle cx="20" cy="20" r="9.5" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
          <g stroke="currentColor" stroke-width="1.6" opacity="0.55" stroke-linecap="round">
            <path d="M20 2.6v3.4M20 34v3.4M37.4 20H34M6 20H2.6M32.3 7.7l-2.4 2.4M10.1 29.9l-2.4 2.4M32.3 32.3l-2.4-2.4M10.1 10.1 7.7 7.7" />
          </g>
          <path
            d="M25.4 13.6a4.7 4.7 0 0 0-6.1 6l-5.2 5.2a1.75 1.75 0 0 0 2.5 2.5l5.2-5.2a4.7 4.7 0 0 0 6-6.1l-2.7 2.7-2.4-2.4z"
            fill="currentColor"
          />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Mobile Mechanic</span>
        <span class="brand__sub">On The Go</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={withBase(item.href)} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>

    <a href={business.phoneHref} class="btn btn--primary hdr__call">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1z" />
      </svg>
      {business.phone}
    </a>

    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mnav" id="mobile-nav" aria-label="Mobile" hidden>
    {nav.map((item) => <a href={withBase(item.href)} class="mnav__link">{item.label}</a>)}
    <a href={business.phoneHref} class="btn btn--primary btn--block mnav__call">Call {business.phone}</a>
  </nav>
</header>

<script>
  const burger = document.querySelector('.burger');
  const mnav = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (mnav) mnav.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });
  const onScroll = () =>
    document.querySelector('.hdr')?.classList.toggle('is-stuck', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(7, 13, 19, 0.72);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .hdr.is-stuck {
    background: rgba(7, 13, 19, 0.95);
    border-bottom-color: var(--border);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 26px;
    min-height: 74px;
  }

  .brand { display: flex; align-items: center; gap: 12px; color: var(--text); margin-right: auto; }
  .brand:hover { color: var(--text); }
  .brand__mark {
    width: 40px; height: 40px;
    display: grid; place-items: center;
    color: var(--brand);
    background: var(--brand-glow);
    border: 1px solid rgba(41, 163, 224, 0.3);
    border-radius: var(--radius);
    flex-shrink: 0;
  }
  .brand__mark svg { width: 27px; height: 27px; }
  .brand__text { display: flex; flex-direction: column; line-height: 1; }
  .brand__name {
    font-family: var(--font-display);
    font-size: clamp(1.02rem, 4.4vw, 1.32rem);
    white-space: nowrap;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .brand__sub {
    font-family: var(--font-display);
    font-size: clamp(0.68rem, 2.9vw, 0.86rem);
    white-space: nowrap;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brand);
    margin-top: 3px;
  }

  .nav { display: none; gap: 28px; }
  .nav__link {
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--steel-300);
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }
  .nav__link:hover { color: var(--white); }
  .nav__link.is-active { color: var(--white); border-bottom-color: var(--brand); }

  .hdr__call { display: none; padding: 12px 20px; font-size: 1.02rem; }

  .burger {
    display: grid;
    place-content: center;
    gap: 5px;
    width: 46px; height: 46px;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .burger span {
    display: block;
    width: 20px; height: 2px;
    background: var(--text);
  }

  .mnav[hidden] { display: none; }
  .mnav {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 22px 26px;
    background: var(--steel-900);
    border-top: 1px solid var(--border);
  }
  .mnav__link {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .mnav__call { margin-top: 20px; }

  @media (min-width: 861px) {
    .nav, .hdr__call { display: flex; }
    .burger, .mnav { display: none !important; }
  }
</style>
