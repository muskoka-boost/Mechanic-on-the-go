---
import { business, hasEmail, hasLicence } from '../data/business';
import { locationsByGroup } from '../data/locations';
import { services } from '../data/services';
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <span class="ftr__name">{business.name}</span>
        <p class="ftr__tag">
          {hasLicence ? 'Licensed mobile' : 'Mobile'} automotive service across
          Orillia, Simcoe County, Muskoka and Georgian Bay. The shop comes to you.
        </p>
        <a href={business.phoneHref} class="btn btn--primary">Call {business.phone}</a>
        <p class="ftr__hours">
          {business.hours.map((h) => (
            <span class="ftr__hourrow"><strong>{h.days}</strong><span>{h.display}</span></span>
          ))}
        </p>
      </div>

      <div class="ftr__col">
        <h4>Services</h4>
        <ul>
          {services.map((s) => (
            <li><a href={withBase(`/services/${s.slug}/`)}>{s.title}</a></li>
          ))}
        </ul>
      </div>

      {locationsByGroup.map((group) => (
        <div class="ftr__col">
          <h4>{group.group}</h4>
          <ul>
            {group.items.map((l) => (
              <li><a href={withBase(`/service-areas/${l.slug}/`)}>{l.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <hr class="hairline" />

    <div class="ftr__bottom">
      <p>&copy; {year} {business.legalName}. All rights reserved.</p>
      <p class="ftr__links">
        <a href={withBase('/service-areas/')}>Service Areas</a>
        <a href={withBase('/faq/')}>FAQ</a>
        <a href={withBase('/contact/')}>Contact</a>
        {hasEmail && <a href={`mailto:${business.email}`}>{business.email}</a>}
      </p>
    </div>
  </div>
</footer>

<style>
  .ftr {
    background: var(--steel-900);
    border-top: 1px solid var(--border);
    padding-block: clamp(52px, 7vw, 84px) 34px;
    font-size: 0.95rem;
  }
  .ftr__top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 40px 30px;
    margin-bottom: 44px;
  }
  .ftr__brand { grid-column: 1 / -1; max-width: 420px; }
  .ftr__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .ftr__tag { color: var(--text-muted); margin-bottom: 22px; }
  .ftr__hours {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 26px;
    color: var(--text-muted);
  }
  .ftr__hourrow { display: flex; justify-content: space-between; gap: 16px; max-width: 320px; }
  .ftr__hourrow strong { color: var(--steel-300); font-weight: 600; }

  .ftr__col h4 {
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    color: var(--brand);
    margin-bottom: 16px;
  }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .ftr__col a { color: var(--text-muted); }
  .ftr__col a:hover { color: var(--white); }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px;
    padding-top: 26px;
    color: var(--text-dim);
  }
  .ftr__bottom p { margin: 0; }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 20px; }
  .ftr__links a { color: var(--text-dim); }
  .ftr__links a:hover { color: var(--white); }

  @media (min-width: 861px) {
    .ftr__brand { grid-column: span 2; }
  }
</style>
