---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { locationsByGroup, locations } from '../../data/locations';
import { business } from '../../data/business';
import { withBase, absUrl } from '../../lib/paths';

const abs = (path: string) => absUrl(Astro.site, path);

const schema = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: abs('/service-areas/') },
  ],
}];
---

<Layout
  title="Service Areas | Mobile Mechanic in Orillia, Barrie, Muskoka & Georgian Bay"
  description={`Mobile mechanic service across ${locations.length} communities including Orillia, Barrie, Gravenhurst, Bracebridge, Midland and the surrounding townships. Roughly ${business.serviceRadiusKm} km from Orillia.`}
  canonical="/service-areas/"
  schema={schema}
>
  <PageHead
    eyebrow="Service areas"
    title="Where we come to you"
    lede={`Based in Orillia and covering roughly ${business.serviceRadiusKm} km in every direction — south to Barrie and Innisfil, north into Muskoka, and west out to the Georgian Bay shoreline. If you are not sure whether you are in range, call and ask.`}
  />

  {locationsByGroup.map((group) => (
    <section class="section section--tight">
      <div class="wrap">
        <h2 class="grouphead">{group.group}</h2>
        <div class="grid grid--3">
          {group.items.map((l) => (
            <a href={withBase(`/service-areas/${l.slug}/`)} class="card loc">
              <h3>{l.name}</h3>
              <span class="loc__time">{l.driveTime}</span>
              <p>{l.lead}</p>
              <span class="loc__more">Details &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    heading="Not sure if you are in range?"
    text="The service radius is a guide, not a wall. Call and say where you are — you will get a straight yes or no, and if it is a no you will get pointed somewhere useful."
  />
</Layout>

<style>
  .grouphead {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    color: var(--brand);
    letter-spacing: 0.06em;
    padding-bottom: 16px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }
  .loc { display: flex; flex-direction: column; color: var(--text); }
  .loc:hover { color: var(--text); transform: translateY(-3px); border-color: rgba(41, 163, 224,0.4); }
  .loc h3 { margin-bottom: 6px; }
  .loc__time {
    font-family: var(--font-display);
    font-size: 0.9rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-dim); margin-bottom: 16px;
  }
  .loc p { color: var(--text-muted); font-size: 0.96rem; }
  .loc__more {
    margin-top: auto; padding-top: 18px;
    font-family: var(--font-display); font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-size: 0.93rem; color: var(--brand);
  }
</style>
