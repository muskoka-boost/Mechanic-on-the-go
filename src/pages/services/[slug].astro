---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { locations } from '../../data/locations';
import { business } from '../../data/business';
import { withBase, absUrl } from '../../lib/paths';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 4);
const topAreas = locations.slice(0, 8);
const abs = (path: string) => absUrl(Astro.site, path);

const url = abs(`/services/${service.slug}/`);

const schema = [
  {
    '@type': 'Service',
    name: `${service.title} — Mobile Service`,
    serviceType: service.title,
    description: service.short,
    url,
    provider: { '@id': `${abs('/')}#business` },
    areaServed: locations.map((l) => ({ '@type': 'City', name: l.name })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Services', item: abs('/services/') },
      { '@type': 'ListItem', position: 3, name: service.title, item: url },
    ],
  },
];
---

<Layout
  title={`Mobile ${service.title} in Orillia & Simcoe County | Mobile Mechanic On The Go`}
  description={`${service.short} Mobile ${service.title.toLowerCase()} at your home, workplace or roadside across Orillia, Barrie, Muskoka and Georgian Bay.`}
  canonical={`/services/${service.slug}/`}
  schema={schema}
>
  <section class="shead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/')}>Home</a><span aria-hidden="true">/</span>
        <a href={withBase('/services/')}>Services</a><span aria-hidden="true">/</span>
        <span aria-current="page">{service.title}</span>
      </nav>
      <span class="shead__icon"><Icon name={service.icon} size={30} /></span>
      <h1>{service.title}</h1>
      <p class="lede shead__lede">{service.short}</p>
      <a href={business.phoneHref} class="btn btn--primary btn--lg">Call {business.phone}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cols">
        <article class="body">
          <p class="lede">{service.blurb}</p>
          <h2>What is included</h2>
          <ul class="ticks">
            {service.details.map((d) => <li>{d}</li>)}
          </ul>

          <h2>How the visit works</h2>
          <p>
            You call and describe the symptom. If it sounds like something that
            can be handled on site, a time gets booked and the van arrives with
            the diagnostic gear and the common parts already loaded. The fault is
            confirmed before anything is replaced, you are told the price, and the
            work only starts once you agree to it.
          </p>
          <p>
            Everything comes away afterwards &mdash; old parts, packaging, used
            fluids. Your driveway is left exactly as it was found.
          </p>

          <h2>Where this service is available</h2>
          <p>
            {service.title} is offered throughout the service area, from Orillia
            and the surrounding townships out to Barrie, Muskoka and Georgian Bay.
          </p>
          <ul class="arealinks">
            {topAreas.map((l) => (
              <li><a href={withBase(`/service-areas/${l.slug}/`)}>{l.name}</a></li>
            ))}
            <li><a href={withBase('/service-areas/')}>All areas &rarr;</a></li>
          </ul>
        </article>

        <aside class="side">
          <div class="card side__card">
            <h3>Book this service</h3>
            <p>Call or text and describe what the vehicle is doing.</p>
            <a href={business.phoneHref} class="btn btn--primary btn--block">Call {business.phone}</a>
            <a href={business.smsHref} class="btn btn--ghost btn--block" style="margin-top:10px;">Send a Text</a>
            <hr class="hairline" style="margin: 22px 0;" />
            <h4>Hours</h4>
            <ul class="side__hours">
              {business.hours.map((h) => (
                <li><span>{h.days}</span><strong>{h.display}</strong></li>
              ))}
            </ul>
          </div>

          <div class="card side__card">
            <h3>Other services</h3>
            <ul class="side__list">
              {others.map((s) => (
                <li><a href={withBase(`/services/${s.slug}/`)}>{s.title}</a></li>
              ))}
              <li><a href={withBase('/services/')}>All services &rarr;</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .shead {
    padding-block: clamp(40px, 6vw, 70px) clamp(44px, 6vw, 70px);
    border-bottom: 1px solid var(--border);
    background: radial-gradient(900px 400px at 6% -20%, rgba(41, 163, 224,0.13), transparent 70%), var(--bg);
  }
  .crumbs { display: flex; flex-wrap: wrap; gap: 10px; font-size: 0.9rem; color: var(--text-dim); margin-bottom: 28px; }
  .crumbs a { color: var(--text-muted); }
  .crumbs a:hover { color: var(--white); }
  .shead__icon {
    display: grid; place-items: center;
    width: 60px; height: 60px;
    border-radius: var(--radius);
    color: var(--brand);
    background: var(--brand-glow);
    border: 1px solid rgba(41, 163, 224,0.3);
    margin-bottom: 22px;
  }
  .shead h1 { max-width: 16ch; margin-bottom: 18px; }
  .shead__lede { max-width: 58ch; margin-bottom: 32px; }

  .cols { display: grid; gap: 44px; align-items: start; }
  .body h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-top: 46px; margin-bottom: 16px; }
  .body h2:first-of-type { margin-top: 36px; }
  .body p { color: var(--steel-300); }

  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .ticks li { position: relative; padding-left: 34px; color: var(--steel-300); }
  .ticks li::before {
    content: ''; position: absolute; left: 0; top: 8px;
    width: 18px; height: 10px;
    border-left: 2.5px solid var(--brand);
    border-bottom: 2.5px solid var(--brand);
    transform: rotate(-45deg);
  }

  .arealinks { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .arealinks a {
    display: inline-block;
    padding: 9px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 100px;
    font-size: 0.92rem;
    color: var(--steel-300);
  }
  .arealinks a:hover { border-color: var(--brand); color: var(--white); }

  .side { display: flex; flex-direction: column; gap: 20px; }
  .side__card h3 { font-size: 1.14rem; margin-bottom: 12px; }
  .side__card > p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 20px; }
  .side__card h4 {
    font-size: 0.86rem; letter-spacing: 0.15em;
    color: var(--brand); margin-bottom: 12px;
  }
  .side__hours { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; font-size: 0.92rem; }
  .side__hours li { display: flex; justify-content: space-between; gap: 14px; color: var(--text-muted); }
  .side__hours strong { color: var(--steel-200); font-weight: 600; }
  .side__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .side__list a { color: var(--steel-300); font-size: 0.96rem; }
  .side__list a:hover { color: var(--white); }

  @media (min-width: 900px) {
    .cols { grid-template-columns: minmax(0, 1fr) 330px; gap: 62px; }
    .side { position: sticky; top: 98px; }
  }
</style>
