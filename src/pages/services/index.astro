---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PageHead from '../../components/PageHead.astro';
import { services } from '../../data/services';
import { business } from '../../data/business';
import { withBase, absUrl } from '../../lib/paths';

const abs = (path: string) => absUrl(Astro.site, path);

const schema = [{
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Services', item: abs('/services/') },
  ],
}];
---

<Layout
  title="Mobile Mechanic Services in Orillia & Simcoe County | Mobile Mechanic On The Go"
  description="Diagnostics, batteries and no-starts, oil and fluid changes, cooling system repairs, tune-ups, tire changeovers and pre-purchase inspections — performed at your home, workplace or roadside across Orillia, Barrie, Muskoka and Georgian Bay."
  canonical="/services/"
  schema={schema}
>
  <PageHead
    eyebrow="Services"
    title="What we fix, and where"
    lede="Everything below is work that can be done properly without a hoist. If a job genuinely needs a shop, you will be told that straight rather than sold a repair that will not hold."
  />

  <section class="section">
    <div class="wrap">
      <div class="grid grid--3">
        {services.map((s) => (
          <a href={withBase(`/services/${s.slug}/`)} class="card svc">
            <span class="svc__icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="svc__more">Read more &rarr;</span>
          </a>
        ))}
      </div>

      <div class="notice">
        <h3>What we do not do</h3>
        <p>
          Being straight about the limits is part of the job. Mounting and
          balancing tyres onto rims, transmission rebuilds and engine
          replacement all need shop equipment. If that is what your vehicle
          needs, you will get told so &mdash; and pointed in the right
          direction.
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .svc { display: flex; flex-direction: column; color: var(--text); }
  .svc:hover { color: var(--text); transform: translateY(-3px); border-color: rgba(41, 163, 224,0.4); }
  .svc__icon {
    display: grid; place-items: center;
    width: 52px; height: 52px;
    border-radius: var(--radius);
    color: var(--brand);
    background: var(--brand-glow);
    border: 1px solid rgba(41, 163, 224,0.28);
    margin-bottom: 20px;
  }
  .svc h3 { margin-bottom: 10px; }
  .svc p { color: var(--text-muted); font-size: 0.98rem; }
  .svc__more {
    margin-top: auto; padding-top: 18px;
    font-family: var(--font-display); font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-size: 0.95rem; color: var(--brand);
  }
  .notice {
    margin-top: 46px;
    padding: 30px 32px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand);
    border-radius: var(--radius-lg);
    background: var(--surface);
    max-width: 780px;
  }
  .notice h3 { color: var(--brand); font-size: 1.12rem; margin-bottom: 12px; }
  .notice p { color: var(--text-muted); margin: 0 0 14px; }
  .notice p:last-child { margin-bottom: 0; }
</style>
